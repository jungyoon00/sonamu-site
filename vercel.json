{
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; object-src 'none'; base-url 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-set-logs",
      "schedule": "0 0 * * *"
    }
  ]
}